# Environment-Variablen für MUC Cargohandling.
# Kopie als `.env.local` anlegen (lokal) bzw. in Vercel → Settings →
# Environment Variables hinterlegen (Produktion). Keine Werte committen.

# ── Supabase — Anfragen-Speicher (Pflicht für Admin-Panel & DB-Persistenz) ──
# Ohne diese Werte läuft die Website normal, Anfragen werden dann nur per
# E-Mail / Webhook / Log weitergereicht.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # "secret" key (sb_secret_… oder service_role JWT) — nur serverseitig!
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # optional, aktuell nicht clientseitig genutzt

# ── Admin-Panel /admin (Pflicht, sonst ist /admin gesperrt) ────────────────
ADMIN_PASSWORD=                       # Master-/Notfall-Passwort, mind. 12 Zeichen
ADMIN_EMAIL=admin                     # E-Mail für den Master-Login (Default: "admin" → Feld leer lassen)
ADMIN_SESSION_SECRET=                 # zufällige 32+ Zeichen (z. B. `openssl rand -hex 32`)
# Team-Benutzer (E-Mail + eigenes Passwort) werden im Panel unter /admin/team
# angelegt und in der Tabelle admin_users gespeichert (Migration 0002).

# ── Datenschutz ────────────────────────────────────────────────────────────
IP_HASH_SALT=                         # zufällig; salzt den IP-Hash in der DB

# ── Push-Benachrichtigungen (Web Push, RFC 8291/8292) ──────────────────────
# Schlüsselpaar einmalig erzeugen, danach unverändert lassen — bei Wechsel
# müssen sich alle Geräte neu anmelden.
VAPID_PUBLIC_KEY=                     # base64url, unkomprimierter P-256-Punkt
VAPID_PRIVATE_KEY=                    # base64url, 32-Byte-Skalar
VAPID_SUBJECT=mailto:info@muc-cargo.de

# ── Kanonische URL ─────────────────────────────────────────────────────────
SITE_URL=https://www.muc-cargo.de     # für absolute Links in E-Mails / Sitemap

# ── E-Mail-Versand via Resend (optional) ──────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=MUC Cargohandling <anfrage@muc-cargo.de>
MAIL_REPLY_TO=info@muc-cargo.de
INQUIRY_NOTIFY_TO=info@muc-cargo.de,stefandirnberger@viawen.com

# ── SMS-Versand via Twilio (optional) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
INQUIRY_SMS_TO=+491637044875

# ── Generischer Webhook (optional, zusätzlich) ────────────────────────────
CONTACT_WEBHOOK_URL=
